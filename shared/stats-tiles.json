{
  "version": 1,
  "layout": {
    "regular": { "columns": 4, "rowHeight": 216, "minWidth": 1040 },
    "compact": { "columns": 2, "rowHeight": 216, "minWidth": 520 },
    "narrow": { "columns": 1, "rowHeight": 220 },
    "gap": 12
  },
  "metrics": {
    "count": { "label": "Activities", "unit": "" },
    "distance": { "label": "Distance", "unit": "km" },
    "elevation": { "label": "Elevation", "unit": "m" },
    "time": { "label": "Moving time", "unit": "h" }
  },
  "groups": [
    { "id": "now", "title": "Now" },
    { "id": "thisYear", "title": "This year" },
    { "id": "patterns", "title": "Patterns" }
  ],
  "tiles": [
    {
      "id": "thisWeek",
      "minHeight": 280,
      "title": "This week",
      "window": "currentWeek",
      "group": "now",
      "span": { "columns": 1, "rows": 1 },
      "toggle": {
        "label": "Metric",
        "options": ["distance", "time", "elevation"]
      }
    },
    {
      "id": "monthVsLastMonth",
      "minHeight": 300,
      "title": "This month",
      "window": "monthToDate",
      "group": "now",
      "span": { "columns": 1, "rows": 1 },
      "toggle": {
        "label": "Metric",
        "options": ["distance", "time", "elevation", "count"]
      }
    },
    {
      "id": "weeklyVolume",
      "minHeight": 280,
      "title": "Training volume",
      "window": "last12Weeks",
      "group": "now",
      "span": { "columns": 2, "rows": 1 },
      "primary": true,
      "toggle": {
        "label": "Metric",
        "options": ["distance", "time", "elevation", "count"]
      }
    },
    {
      "id": "yearToDate",
      "minHeight": 300,
      "title": "Year to date",
      "window": "yearToDate",
      "group": "thisYear",
      "span": { "columns": 2, "rows": 1 },
      "primary": true,
      "toggle": {
        "label": "Metric",
        "options": ["distance", "time", "elevation", "count"]
      }
    },
    {
      "id": "yearPace",
      "minHeight": 280,
      "title": "Year-end projection",
      "window": "yearToDate",
      "group": "thisYear",
      "span": { "columns": 1, "rows": 1 },
      "toggle": {
        "label": "Metric",
        "options": ["distance", "time", "elevation"]
      }
    },
    {
      "id": "records",
      "title": "Records",
      "window": "currentYear",
      "group": "thisYear",
      "span": { "columns": 2, "rows": 1 }
    },
    {
      "id": "totals",
      "title": "Totals",
      "window": "currentYear",
      "group": "thisYear",
      "span": { "columns": 2, "rows": 1 },
      "optional": true,
      "toggle": {
        "label": "Metric",
        "options": ["distance", "time", "elevation", "count"]
      }
    },
    {
      "id": "activityCalendar",
      "title": "Activity calendar",
      "window": "last12Months",
      "group": "patterns",
      "span": { "columns": 2, "rows": 2 },
      "toggle": {
        "label": "Colour by",
        "options": ["sport", "distance", "time", "elevation"]
      }
    },
    {
      "id": "consistency",
      "title": "Consistency",
      "window": "last12Weeks",
      "group": "patterns",
      "span": { "columns": 1, "rows": 1 },
      "toggle": { "label": "Range", "options": ["last12Weeks", "last52Weeks"] }
    },
    {
      "id": "sportMix",
      "minHeight": 280,
      "title": "Sport mix",
      "window": "currentYear",
      "group": "patterns",
      "span": { "columns": 1, "rows": 1 },
      "toggle": { "label": "Range", "options": ["currentYear", "allTime"] }
    },
    {
      "id": "distanceVsElevation",
      "minHeight": 280,
      "title": "Hilliness",
      "window": "last12Months",
      "group": "patterns",
      "span": { "columns": 2, "rows": 1 }
    },
    {
      "id": "typicalWeek",
      "title": "Typical week",
      "window": "last12Weeks",
      "group": "patterns",
      "span": { "columns": 1, "rows": 1 }
    },
    {
      "id": "best30Days",
      "title": "Best 30 days",
      "window": "currentYear",
      "group": "patterns",
      "span": { "columns": 1, "rows": 1 },
      "toggle": {
        "label": "Metric",
        "options": ["distance", "time", "elevation"]
      }
    },
    {
      "id": "restDays",
      "title": "Rest days",
      "window": "last90Days",
      "group": "patterns",
      "span": { "columns": 1, "rows": 1 }
    },
    {
      "id": "speedTrend",
      "title": "Speed trend",
      "window": "last12Months",
      "group": "patterns",
      "span": { "columns": 1, "rows": 1 },
      "optional": true,
      "toggle": { "label": "Range", "options": ["last12Months", "allTime"] }
    }
  ]
}
