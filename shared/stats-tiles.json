{
  "version": 1,
  "layout": {
    "regular": { "columns": 4, "rowHeight": 168, "minWidth": 720 },
    "compact": { "columns": 2, "rowHeight": 156 },
    "gap": 12
  },
  "metrics": {
    "count": { "label": "Activities", "unit": "" },
    "distance": { "label": "Distance", "unit": "km" },
    "elevation": { "label": "Elevation", "unit": "m" },
    "time": { "label": "Moving time", "unit": "h" }
  },
  "tiles": [
    {
      "id": "yearToDate",
      "title": "Year to date",
      "window": "yearToDate",
      "span": { "columns": 2, "rows": 2 },
      "toggle": {
        "label": "Metric",
        "options": ["distance", "elevation", "time", "count"]
      }
    },
    {
      "id": "totals",
      "title": "Totals",
      "window": "currentYear",
      "span": { "columns": 2, "rows": 1 },
      "toggle": {
        "label": "Metric",
        "options": ["count", "distance", "elevation", "time"]
      }
    },
    {
      "id": "weeklyVolume",
      "title": "Weekly volume",
      "window": "last12Weeks",
      "span": { "columns": 2, "rows": 1 },
      "toggle": {
        "label": "Metric",
        "options": ["distance", "elevation", "time", "count"]
      }
    },
    {
      "id": "activityCalendar",
      "title": "Activity calendar",
      "window": "last12Months",
      "span": { "columns": 2, "rows": 1 },
      "toggle": {
        "label": "Colour by",
        "options": ["sport", "distance", "elevation", "time"]
      }
    },
    {
      "id": "monthVsLastMonth",
      "title": "This month",
      "window": "monthToDate",
      "span": { "columns": 1, "rows": 1 },
      "toggle": {
        "label": "Metric",
        "options": ["elevation", "distance", "time", "count"]
      }
    },
    {
      "id": "sportMix",
      "title": "Sport mix",
      "window": "currentYear",
      "span": { "columns": 1, "rows": 1 },
      "toggle": {
        "label": "Range",
        "options": ["currentYear", "allTime"]
      }
    },
    {
      "id": "consistency",
      "title": "Consistency",
      "window": "last12Weeks",
      "span": { "columns": 1, "rows": 1 },
      "toggle": {
        "label": "Range",
        "options": ["last12Weeks", "last52Weeks"]
      }
    },
    {
      "id": "distanceVsElevation",
      "title": "Distance vs elevation",
      "window": "last12Months",
      "span": { "columns": 2, "rows": 1 }
    },
    {
      "id": "speedTrend",
      "title": "Speed trend",
      "window": "last12Months",
      "span": { "columns": 1, "rows": 1 },
      "optional": true,
      "toggle": {
        "label": "Range",
        "options": ["last12Months", "allTime"]
      }
    }
  ]
}
