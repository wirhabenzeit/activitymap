{
  "version": 1,
  "variantCases": [
    {
      "name": "dimensions outrank keys and URL insertion order",
      "urls": {
        "large": "https://photos.test/panorama",
        "small": "https://photos.test/thumb",
        "medium": "https://photos.test/full"
      },
      "sizes": {
        "small": [320, 200],
        "medium": [1600, 1000],
        "large": [4096, 500]
      },
      "thumbnail": {
        "url": "https://photos.test/thumb",
        "width": 320,
        "height": 200
      },
      "full": {
        "url": "https://photos.test/full",
        "width": 1600,
        "height": 1000
      }
    },
    {
      "name": "portrait longest edge",
      "urls": {
        "one": "https://photos.test/portrait",
        "two": "https://photos.test/small-portrait"
      },
      "sizes": { "one": [1000, 1800], "two": [200, 360] },
      "thumbnail": {
        "url": "https://photos.test/small-portrait",
        "width": 200,
        "height": 360
      },
      "full": {
        "url": "https://photos.test/portrait",
        "width": 1000,
        "height": 1800
      }
    },
    {
      "name": "numeric URL keys with mismatched dimension metadata",
      "urls": {
        "2048": "https://photos.test/2048",
        "128": "https://photos.test/128",
        "512": "https://photos.test/512"
      },
      "sizes": { "other": [99, 99], "512": [0, -1] },
      "thumbnail": { "url": "https://photos.test/512" },
      "full": { "url": "https://photos.test/2048" }
    },
    {
      "name": "only tiny variants",
      "urls": {
        "64": "https://photos.test/64",
        "128": "https://photos.test/128"
      },
      "sizes": null,
      "thumbnail": { "url": "https://photos.test/128" },
      "full": { "url": "https://photos.test/128" }
    },
    {
      "name": "only oversized variants",
      "urls": {
        "4096": "https://photos.test/4096",
        "3000": "https://photos.test/3000"
      },
      "sizes": null,
      "thumbnail": { "url": "https://photos.test/3000" },
      "full": { "url": "https://photos.test/3000" }
    },
    {
      "name": "unknown sizes use stable scalar key order",
      "urls": {
        "z": "https://photos.test/z",
        "a": "https://photos.test/a",
        "bad": "javascript:alert(1)",
        "empty": ""
      },
      "sizes": null,
      "thumbnail": { "url": "https://photos.test/a" },
      "full": { "url": "https://photos.test/a" }
    },
    {
      "name": "missing and unsafe URLs",
      "urls": {
        "128": "",
        "512": "not-a-url",
        "1024": "file:///private/photo.jpg"
      },
      "sizes": null,
      "thumbnail": null,
      "full": null
    },
    {
      "name": "no variants",
      "urls": null,
      "sizes": null,
      "thumbnail": null,
      "full": null
    }
  ],
  "orderCases": [
    {
      "name": "dates then scalar IDs with unknown dates last",
      "photos": [
        { "id": "missing-b", "created_at": null },
        { "id": "same-b", "created_at": "2026-01-02T00:00:00Z" },
        { "id": "old", "created_at": "2026-01-01T00:00:00Z" },
        { "id": "same-a", "created_at": "2026-01-02T00:00:00Z" },
        { "id": "missing-a", "created_at": null }
      ],
      "expected_ids": ["old", "same-a", "same-b", "missing-a", "missing-b"]
    },
    { "name": "empty", "photos": [], "expected_ids": [] },
    {
      "name": "one unavailable photo remains",
      "photos": [{ "id": "unavailable", "created_at": null }],
      "expected_ids": ["unavailable"]
    }
  ]
}
