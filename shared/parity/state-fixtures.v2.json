          "expected": {
            "selected_ids": ["101", "102"],
            "active_id": "102",
            "inspected_id": "103",
            "visible_ids": ["101", "102", "103"],
            "combine": false,
            "only_selected": false,
            "displayed_ids": ["101", "102", "103"]
