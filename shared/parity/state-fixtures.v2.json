          "expected": {
            "selected_ids": [],
            "active_id": null,
            "inspected_id": "103",
            "visible_ids": ["101", "102", "103"],
            "combine": false,
            "only_selected": false,
            "displayed_ids": ["101", "102", "103"]
          }
        },
        {
          "name": "single selection activates",
          "event": {
            "type": "replace_selection",
            "ids": ["101"]
          },
          "expected": {
            "selected_ids": ["101"],
            "active_id": "101",
            "inspected_id": "103",
            "visible_ids": ["101", "102", "103"],
            "combine": false,
            "only_selected": false,
            "displayed_ids": ["101", "102", "103"]
          }
        },
        {
          "name": "adding preserves the existing active route",
          "event": {
            "type": "add_selection",
            "ids": ["102"]
          },
          "expected": {
            "selected_ids": ["101", "102"],
            "active_id": "101",
            "inspected_id": "103",
            "visible_ids": ["101", "102", "103"],
            "combine": false,
            "only_selected": false,
            "displayed_ids": ["101", "102", "103"]
