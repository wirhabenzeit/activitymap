{
  "name": "activity-map",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "python3 scripts/generate-app-icons.py",
    "build": "pnpm db:migrate:preview && next build",
    "dev": "pnpm db:migrate && next dev --turbo",
    "lint": "eslint .",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrations:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/database/migrate.ts apply",
    "db:migrate:status": "tsx scripts/database/migrate.ts status",
    "db:migrate:check": "tsx scripts/database/migrate.ts check",
    "db:migrate:test-geometry-state": "tsx scripts/database/test-geometry-state-migration.ts",
    "db:migrate:test-webhook": "tsx scripts/database/test-webhook-inbox-migration.ts",
    "db:test-erasure": "tsx --conditions=react-server scripts/database/test-erasure-executor.ts",
    "db:test-legacy-sync-selection": "tsx --conditions=react-server scripts/database/test-legacy-activity-sync-selection.ts",
    "db:test-summary-reconciliation": "tsx --conditions=react-server scripts/database/test-summary-reconciliation.ts",
    "db:test-activity-streams": "tsx --conditions=react-server scripts/database/test-activity-streams.ts",
    "db:test-activity-places": "tsx --conditions=react-server scripts/database/test-activity-places.ts",
    "db:test-place-catalogue": "tsx --conditions=react-server scripts/database/test-place-catalogue-import.ts",
    "db:test-place-refresh": "tsx --conditions=react-server scripts/database/test-place-catalogue-refresh.ts",
    "places:prepare": "tsx --conditions=react-server scripts/places/prepare-catalogue.ts",
    "places:combine": "tsx --conditions=react-server scripts/places/combine-catalogues.ts",
    "places:publish": "tsx --conditions=react-server scripts/places/publish-catalogue.ts",
    "db:migrate:test-stream-lifecycle": "tsx scripts/database/test-stream-lifecycle-migration.ts",
    "db:test-stream-lifecycle": "tsx --conditions=react-server scripts/database/test-stream-lifecycle.ts",
    "db:audit-sync-migration": "tsx scripts/database/audit-sync-migration.ts",
    "db:migrate:preview": "tsx scripts/database/migrate-preview.ts",
    "db:schema:fingerprint": "tsx scripts/database/migrate.ts fingerprint",
    "db:baseline:adopt": "tsx scripts/database/migrate.ts adopt-baseline",
    "test": "tsx --conditions=react-server --test \"src/**/*.test.ts\" \"cloudflare/**/*.test.ts\"",
    "test:settings-ui": "tsx --test src/hooks/use-ingestion-status.test.tsx src/lib/first-summary-fetch.test.tsx",
    "test:account-deletion-ui": "node scripts/verify-account-deletion.mjs",
    "test:stats-ui": "tsx --test src/components/stats/tiles/*.test.ts src/components/stats/tiles/*.test.tsx",
    "test:stats-focus": "node scripts/verify-stats-focus.mjs",
    "test:list-ui": "node scripts/verify-list-inspection.mjs",
    "test:sync": "tsx src/scripts/test-sync-activities.ts",
    "cron:deploy": "pnpm dlx wrangler@4 deploy --config cloudflare/cron/wrangler.jsonc",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:verify-swift": "bash scripts/verify-swift-client.sh",
    "openapi:check-breaking": "tsx scripts/check-openapi-breaking-changes.ts",
    "map-catalog:generate": "tsx scripts/generate-map-catalog-swift.ts",
    "map-catalog:check": "tsx scripts/generate-map-catalog-swift.ts --check",
    "api-dtos:generate": "tsx scripts/generate-api-dtos-swift.ts",
    "api-dtos:check": "tsx scripts/generate-api-dtos-swift.ts --check",
    "friflyt:enrich": "node scripts/enrich-friflyt-geojson.mjs",
    "friflyt:enrich:translate": "node scripts/enrich-friflyt-geojson.mjs --translate",
    "db:test-stream-backfill": "tsx --conditions=react-server scripts/database/test-stream-backfill.ts",
    "db:test-ingestion-status": "tsx --conditions=react-server scripts/database/test-ingestion-status.ts",
    "stats-tiles:generate": "tsx scripts/generate-stats-tiles.ts",
    "stats-tiles:check": "tsx scripts/generate-stats-tiles.ts --check",
    "db:convert-stream-summaries": "tsx --conditions=react-server scripts/database/convert-stream-summaries.ts",
    "benchmark:compact-streams": "tsx scripts/benchmark-compact-streams.ts",
    "benchmark:place-matching": "tsx --conditions=react-server scripts/benchmark-place-matching.ts",
    "test:compact-stream-swift": "bash scripts/verify-compact-stream-codec.sh",
    "db:test-photo-backfill": "tsx --conditions=react-server scripts/database/test-photo-backfill.ts",
    "db:test-strava-import": "tsx --conditions=react-server scripts/database/test-strava-import.ts",
    "typecheck": "tsc --noEmit",
    "check:generated": "pnpm map-catalog:check && pnpm stats-tiles:check && pnpm api-dtos:check && pnpm presentation:check",
    "check": "pnpm typecheck && pnpm lint && pnpm check:generated && pnpm test && pnpm test:browsing-ui && pnpm test:stats-ui && pnpm test:settings-ui && pnpm test:quality-harness",
    "test:quality-harness": "node --test scripts/quality/*.test.mjs",
    "test:browser:install": "playwright-core install chromium",
    "test:browser": "node scripts/quality/browser-harness.mjs",
    "test:ios": "node scripts/quality/native-harness.mjs",
    "format:check": "node scripts/quality/format-check.mjs",
    "test:sync-integrity": "node scripts/verify-sync-integrity.mjs",
    "test:library-owner": "node scripts/run-library-owner-browser.mjs",
    "presentation:generate": "node scripts/generate-presentation.mjs && node scripts/generate-place-symbols.mjs",
    "presentation:check": "node scripts/generate-presentation.mjs --check && node --test scripts/presentation.test.mjs && node scripts/generate-place-symbols.mjs --check",
    "test:browsing-ui": "tsx --test src/components/list/*.test.tsx",
    "db:test-on-demand-places": "tsx --conditions=react-server scripts/database/test-on-demand-places.ts",
    "test:activity-places-ui": "node scripts/verify-activity-places.mjs",
    "test:place-search-ui": "node scripts/verify-place-search.mjs",
    "test:place-debug-ui": "node scripts/verify-place-debug.mjs",
    "db:test-place-matching": "tsx --conditions=react-server scripts/database/test-place-matching.ts",
    "places:match-local": "tsx --conditions=react-server scripts/match-activity-places.ts",
    "benchmark:regional-place-matching": "tsx --conditions=react-server scripts/benchmark-regional-place-matching.ts",
    "benchmark:place-matching-io": "tsx --conditions=react-server scripts/benchmark-place-matching-io.ts",
    "benchmark:admin-dashboard": "tsx --conditions=react-server scripts/benchmark-admin-dashboard.ts"
  },
