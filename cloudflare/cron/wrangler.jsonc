{
  // Triggers ActivityMap's scheduled jobs on time; see src/jobs.ts and
  // docs/scheduled-jobs.md. Deploy with `pnpm cron:deploy`.
  "name": "activitymap-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Scheduled only: no public URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 * * * *",
      "17 * * * *",
      "37 * * * *",
      "47 * * * *",
    ],
  },
  "vars": {
    "ACTIVITYMAP_URL": "https://activitymap.cc",
  },
  "observability": { "enabled": true },
}
