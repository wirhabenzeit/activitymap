{
  // Triggers ActivityMap's scheduled jobs on time; see src/jobs.ts and
  // docs/scheduled-jobs.md. Deploy with `pnpm cron:deploy`.
  "name": "activitymap-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Scheduled only: no public URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "vars": {
    "ACTIVITYMAP_URL": "https://activitymap.cc",
    "APP_STORE_APP_ID": "6819172681",
  },
  // TestFlight crash reports; schema in migrations/.
  "d1_databases": [
    {
      "binding": "TESTFLIGHT_DB",
      "database_name": "activitymap-testflight",
      "database_id": "5c350c6a-fcf8-4f03-962a-525f894b8371",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
