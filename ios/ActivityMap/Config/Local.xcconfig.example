// Copy this file to Local.xcconfig and use a public MapTiler key.
// Restrict native requests with Allowed User-Agent: ActivityMap/1.0.
MAPTILER_KEY = your-public-maptiler-key

// Base.xcconfig sends simulator builds to localhost and physical-device builds
// to production. To point a phone at another HTTPS deployment, override only
// the device setting here:
//
// ACTIVITYMAP_API_BASE_URL[sdk=iphoneos*] = https:$(SLASH)$(SLASH)your-host.example
//
// For local backend development on a phone, replace that URL with an HTTPS
// tunnel to the Mac. The tunnel host must also be allowed by Better Auth,
// and Strava's OAuth callback must return through the same reachable host.
// Remember that "//" starts a comment in xcconfig, so build URLs from
// $(SLASH) rather than typing the separator literally.
//
// ACTIVITYMAP_API_BASE_URL = https:$(SLASH)$(SLASH)your-host.example
//
// Device builds return from sign-in through the https universal link
// https://activitymap.cc/auth/callback; simulator builds use the custom scheme
// activitymap://auth/callback. Production must allow both while older builds
// are installed. To test a different deployment on a phone, point the base URL
// at it and use a custom-scheme redirect, which needs no associated domain:
//
// ACTIVITYMAP_AUTH_REDIRECT_URI[sdk=iphoneos*] = activitymap:$(SLASH)$(SLASH)auth/callback
//
// Changing the callback scheme also requires updating the server's
// MOBILE_AUTH_REDIRECT_ALLOWLIST to match, or sign-in is rejected. The
// ActivityMap Dev build uses activitymap-dev, so production must allow both
// activitymap://auth/callback and activitymap-dev://auth/callback.
// ACTIVITYMAP_AUTH_CALLBACK_SCHEME = activitymap
