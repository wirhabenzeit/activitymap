// Copy this file to Local.xcconfig and use a URL-restricted public token.
MAPBOX_ACCESS_TOKEN = pk.your-public-mapbox-token

// Base.xcconfig sends simulator builds to localhost and physical-device builds
// to production. To point a phone at another HTTPS deployment, override only
// the device setting here:
//
// ACTIVITYMAP_API_BASE_URL[sdk=iphoneos*] = https:$(SLASH)$(SLASH)your-host.example
//
// For local backend development on a phone, replace that URL with an HTTPS
// tunnel to the Mac. The tunnel host must also be allowed by Better Auth,
// and Strava's OAuth callback must return through the same reachable host.
// Remember that "//" starts a comment in xcconfig, so build URLs from
// $(SLASH) rather than typing the separator literally.
//
// ACTIVITYMAP_API_BASE_URL = https:$(SLASH)$(SLASH)your-host.example
//
// Changing the callback scheme also requires updating the server's
// MOBILE_AUTH_REDIRECT_ALLOWLIST to match, or sign-in is rejected.
// ACTIVITYMAP_AUTH_CALLBACK_SCHEME = activitymap
