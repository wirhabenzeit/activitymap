# Copy to .env and fill in. Every variable here is validated by src/env.js
# unless marked optional — the build fails if a required one is missing.

# --- Database -------------------------------------------------------------
# The app's runtime connection (pooled). This is the only database URL any
# runtime code reads; see src/server/db/index.ts.
DATABASE_URL=

# Direct, non-pooled connection, used by the schema tooling (db:generate,
# db:migrate, db:baseline, db:studio). Migrations run in a single transaction
# that Neon's pooled endpoint cannot hold, so this must not be the pooled URL.
DATABASE_URL_UNPOOLED=

# Optional. Fallbacks for the schema tooling and a presence check in
# drizzle/reset.ts. Nothing else reads them.
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Optional. Points the schema tooling at the local Docker database instead of
# whatever the URLs above say. See LOCAL_DB_SETUP.md.
# USE_LOCAL_DB=true

# --- Auth -----------------------------------------------------------------
# Read by better-auth itself: src/lib/auth.ts passes neither `secret` nor
# `baseURL`, so the library falls back to these.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Strava OAuth application credentials.
AUTH_STRAVA_ID=
AUTH_STRAVA_SECRET=

# --- Strava ---------------------------------------------------------------
# Shared secret echoed back during Strava's webhook subscription handshake.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# --- App ------------------------------------------------------------------
PUBLIC_URL=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Shared secret for the twice-daily sync workflow (.github/workflows/fetch.yml).
CRON_SECRET=

# Optional.
# NEXT_PUBLIC_APP_URL=   # better-auth client baseURL; defaults to localhost:3000
# NEXT_PUBLIC_ENV=       # 'development' | 'production'

# --- Scripts only ---------------------------------------------------------
# Needed only by `pnpm friflyt:enrich:translate`. Not required to run the app.
# OPENAI_API_KEY=
