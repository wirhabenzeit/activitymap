# Application runtime. Local development defaults to the Docker database when
# DATABASE_URL is omitted.
# DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main
# NEON_DATABASE_URL=
AUTH_SECRET=replace-with-a-local-auth-secret
NEXT_PUBLIC_MAPBOX_TOKEN=replace-with-a-public-mapbox-token
NEXT_PUBLIC_ENV=development

# Schema tooling. Remote values must be direct/unpooled connections and must be
# accompanied by the expected target identity.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/main
MIGRATION_EXPECTED_HOST=localhost
MIGRATION_EXPECTED_DATABASE=main
# MIGRATION_EXPECTED_BRANCH_ID=
# Preview builds use this deny guard instead of knowing their dynamic branch ID.
# MIGRATION_FORBIDDEN_BRANCH_ID=
# MIGRATION_PRODUCTION_GIT_BRANCH=main
MIGRATION_REQUIRE_TARGET_GUARDS=false

# External effects are fail-closed. Keep them disabled outside Production unless
# deliberately running local integration tests with the required credentials.
ACTIVITYMAP_EXTERNAL_EFFECTS=disabled
# AUTH_STRAVA_ID=
# AUTH_STRAVA_SECRET=
# STRAVA_WEBHOOK_VERIFY_TOKEN=
# CRON_SECRET=
# PUBLIC_URL=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=

# Mobile authentication (issue #121). Comma-separated list of allowed
# origin+path prefixes for the mobile-auth redirect; any redirect_uri outside
# this list is rejected, matched on exact protocol, host, and path prefix.
#
# This file is documentation only, so uncommenting a line here configures
# nothing. The value has to exist in .env, .env.local, or Vercel.
#
# Local iOS development uses a custom scheme, and the value must match the app's
# ACTIVITYMAP_AUTH_REDIRECT_URI in ios/ActivityMap/Config/Base.xcconfig:
# MOBILE_AUTH_REDIRECT_ALLOWLIST=activitymap://auth/callback
#
# This allow-list alone is not enough to sign in. The Strava provider is only
# registered when ACTIVITYMAP_EXTERNAL_EFFECTS=enabled (see src/lib/auth.ts), so
# native sign-in also needs that plus AUTH_STRAVA_ID/SECRET and the BETTER_AUTH
# values. Preview deployments keep external effects disabled and therefore
# cannot authenticate at all. See ios/ActivityMap/README.md.
#
# A production build using universal links instead would add its https origin,
# which additionally requires an Associated Domains entitlement and a hosted
# AASA file:
# MOBILE_AUTH_REDIRECT_ALLOWLIST=activitymap://auth/callback,https://app.activitymap.example/auth/callback
