# Application runtime.
AUTH_SECRET=replace-with-a-local-auth-secret
NEXT_PUBLIC_MAPBOX_TOKEN=replace-with-a-public-mapbox-token
NEXT_PUBLIC_ENV=development

# Automated external effects are fail-closed. Keep them disabled outside
# Production unless deliberately running local integration tests.
# ACTIVITYMAP_EXTERNAL_EFFECTS=enabled
# Vercel Preview enables interactive Strava login and user-initiated API calls
# automatically. These credentials and the OAuth proxy settings are required
# in the Vercel Preview environment; webhooks and cron remain disabled.
# AUTH_STRAVA_ID=
# AUTH_STRAVA_SECRET=
# OAUTH_PROXY_PRODUCTION_URL=https://activitymap.cc
# OAUTH_PROXY_SECRET=
# STRAVA_WEBHOOK_VERIFY_TOKEN=
# Secret path segment of the Strava webhook callback URL (32-128 chars of A-Z a-z 0-9 _ -).
# Generate with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# STRAVA_WEBHOOK_CALLBACK_SECRET=
# CRON_SECRET=
# PUBLIC_URL=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=

# Mobile authentication (issue #121). Comma-separated list of allowed
# origin+path prefixes for the mobile-auth redirect; any redirect_uri outside
# this list is rejected, matched on exact protocol, host, and path prefix.
#
# This file is documentation only, so uncommenting a line here configures
# nothing. The value has to exist in .env, .env.local, or Vercel.
#
# Local iOS development uses a custom scheme, and the value must match the app's
# ACTIVITYMAP_AUTH_REDIRECT_URI in ios/ActivityMap/Config/Base.xcconfig:
# MOBILE_AUTH_REDIRECT_ALLOWLIST=activitymap://auth/callback
#
# This allow-list alone is not enough to sign in. Local sign-in requires
# ACTIVITYMAP_EXTERNAL_EFFECTS=enabled and Strava/Better Auth credentials.
# Vercel Preview sign-in uses the OAuth proxy setup in
# docs/preview-strava-login.md.
#
# A production build using universal links instead would add its https origin,
# which additionally requires an Associated Domains entitlement and a hosted
# AASA file:
# MOBILE_AUTH_REDIRECT_ALLOWLIST=activitymap://auth/callback,https://app.activitymap.example/auth/callback

# Historical stream backfill runs by default in production with external effects
# enabled. Preview/local workers remain disabled. Set this optional switch to
# disabled to pause the endpoint; the matching GitHub repository variable can
# separately pause the hourly workflow step.
# ACTIVITYMAP_STREAM_BACKFILL=disabled

# Summary storage rollout: use json while older array-only servers/workers drain.
# Both API formats remain readable. See docs/compact-stream-summaries.md.
ACTIVITYMAP_STREAM_SUMMARY_STORAGE_FORMAT="json"

# Photo catch-up runs by default in production with external effects enabled.
# Apply migration 0018 before deploying. Preview/local workers remain disabled.
# Set this optional switch to disabled to pause the endpoint; the matching
# GitHub repository variable can separately pause the hourly workflow step.
# ACTIVITYMAP_PHOTO_BACKFILL=disabled

# Strava athlete ids allowed to open /admin and use web place matching debug
# mode (comma-separated). Unset means nobody; everyone else gets a 404.
# ACTIVITYMAP_ADMIN_ATHLETE_IDS=123456

# Short-lived Better Auth JWTs for the Convex application backend
# (docs/convex-reactive-reads.md). Unset: no tokens are issued.
# ACTIVITYMAP_AUTH_JWT_ISSUER="https://activitymap.cc"
