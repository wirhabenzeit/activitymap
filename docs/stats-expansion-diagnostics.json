  "findings": [
    {
      "status": "measured",
      "finding": "Year-to-date presentation is expensive during expansion. At 402pt, production settles around 405ms versus about 58ms without animation. Freezing descendant progress alone leaves most of this cost."
    },
    {
      "status": "measured",
      "finding": "Stable one-column neighbors are mostly cached: in the warmed volume expansion, thisWeek and monthVsLastMonth each receive only two diagnostic size measurements, while the expanded volume receives many. The issue theory that every neighbor is remeasured every frame is too broad."
    },
    {
      "status": "source-confirmed",
      "finding": "Expansion changes only expandedTile, outside the dashboard query request key. Cached analytics are reused; no stream fetch or analytics recalculation is required."
    },
    {
      "status": "source-confirmed-and-measured",
      "finding": "The height limit applies only below a 480pt viewport, excludes accessibility text sizes, and caps individual visuals rather than the whole tile. Long Records and Hilliness content never uses that cap. Even the limited landscape calendar remains too tall."
    },
    {
      "status": "source-confirmed",
      "finding": "Portrait expansion skips scrollTo. A tile can fit in the viewport but still expand partly below the visible area."
    },
    {
      "status": "source-confirmed",
      "finding": "The inclusive rolling calendar crosses 13 calendar months, including partial first and last months. This is existing date semantics, not a request to drop days."
    },
    {
      "status": "source-inference",
      "finding": "Numeric calendar colors repeatedly compute the maximum over all active days per active cell, potentially quadratic work per color pass. This is an additional optimization opportunity, not an established dominant hotspot."
    }
  ],
  "nextImplementation": [
    "Separate card movement/reveal from the continuous invalidation of expensive live chart content; compare against these diagnostics and inspect actual intermediate frames. Simply shortening the duration or freezing the height is insufficient for year-to-date.",
    "Use a whole-tile phone height budget, accounting for measured headers and controls. Page or scroll long calendar/list content instead of clipping it; preserve readable text and local inspection state.",
    "Keep the expanded tile visible in portrait as well as landscape, and regression-check two-column row expansion and Reduce Motion."
  ],
  "limitations": [
    "One expand and one collapse sample per combination, after warming both endpoints; these are diagnostic comparisons, not statistical performance budgets.",
    "Process CPU includes all test-host threads. Display-link callback gaps indicate main-run-loop availability, not measured GPU-presented frame rates.",
    "Timing uses an isolated production section, not the entire app shell. Height checks use isolated production tiles and explicit content budgets, not a final physical-device layout certification.",
    "The endpoint and cached-endpoint controls deliberately change transition behavior and can reset local state; they are experiments, not proposed production patches.",
    "Physical iPhone unavailable during investigation. Device recording and iPad/accessibility acceptance remain open."
  ],
